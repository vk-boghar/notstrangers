---
// Shared bits for every /learn page: the always-visible emergency strip and one
// small script for on-device progress, tabs, games, builders and sharing. No accounts, no network:
// progress and plans live in this browser's localStorage only, wrapped so the page works without it.
import { METRICS_URL, type Lang } from '../../config/site';
import CountScript from './CountScript.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="sos-strip" role="complementary" aria-label="Emergency help">
  <span>{lang === 'ta' ? 'உடனடி உதவி?' : 'Need help now?'}</span>
  <a href="tel:1098"><strong>1098</strong> Childline</a>
  <a href="tel:112"><strong>112</strong> {lang === 'ta' ? 'அவசரம்' : 'Emergency'}</a>
</div>
<div id="ns-metrics" hidden data-url={METRICS_URL}></div>
<CountScript />
<noscript><style>.js-only{display:none!important}.fb{display:block!important}.tab-panel{display:block!important}</style></noscript>
<style>
  :global(body) { padding-bottom: 64px; }
  .ta-note { margin: 0 0 20px; }
  .sos-strip {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 25; display: flex; justify-content: center; align-items: center;
    gap: 8px 12px; padding: 8px 12px calc(8px + env(safe-area-inset-bottom)); background: var(--ink); color: var(--bg); font-size: 0.875rem;
  }
  .sos-strip a { white-space: nowrap; color: var(--bg); text-decoration: none; background: color-mix(in oklch, var(--bg) 14%, transparent); border-radius: 999px; padding: 8px 14px; min-height: 40px; display: inline-flex; align-items: center; gap: 6px; }
  .sos-strip a:hover { background: color-mix(in oklch, var(--bg) 24%, transparent); }
  :global(.prog) { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 0.75rem; }
  :global(.prog b) { flex: 1; height: 6px; border-radius: 3px; background: color-mix(in oklch, currentColor 18%, transparent); overflow: hidden; display: block; }
  :global(.prog i) { display: block; height: 100%; width: 0; background: currentColor; border-radius: 3px; transition: width .4s; }
  :global(.prog em) { font-style: normal; white-space: nowrap; }
  @media (max-width: 400px) { .sos-strip > span { display: none; } }
  @media print { .sos-strip { display: none; } :global(body) { padding-bottom: 0; } }
</style>
<script is:inline>
(function (run) { if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run(); })(function () {
  var KEY = 'ns-learn-v1';
  function load(k, d) { try { var v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; } catch (e) { return d; } }
  function save(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
  var done = load(KEY, []);
  // Anonymous completion counter: one event per module per browser, deduplicated here with
  // ns_done_<slug>. Nothing identifying is sent. Off entirely when no metrics URL is configured.
  var MURL = (document.getElementById('ns-metrics') || { dataset: {} }).dataset.url;
  function slug(id) { var n = id.slice(1); return { p: 'parents', k: 'kids', t: 'teens' }[id[0]] + '-' + (n.length < 2 ? '0' + n : n); }
  function send(o) { if (!MURL || !window.fetch) return; try { fetch(MURL + '/event', { method: 'POST', mode: 'cors', keepalive: true, headers: { 'Content-Type': 'text/plain' }, body: JSON.stringify(o) }).catch(function () {}); } catch (e) {} }
  function completed(id, s) {
    if (done.indexOf(id) < 0) { done.push(id); save(KEY, done); }
    s = s || slug(id); var k = 'ns_done_' + s;
    if (load(k, null)) return; save(k, 1);
    send({ event: 'module_complete', module: s, v: 1 });
    if (!load('ns_learner', null)) { save('ns_learner', 1); send({ event: 'learner', v: 1 }); }
  }
  function paint() {
    document.querySelectorAll('[data-mod]').forEach(function (el) { el.classList.toggle('is-done', done.indexOf(el.dataset.mod) > -1); });
    document.querySelectorAll('[data-progress]').forEach(function (el) {
      var ids = el.dataset.progress.split(','), n = ids.filter(function (i) { return done.indexOf(i) > -1; }).length;
      var bar = el.querySelector('i'); if (bar) bar.style.width = (100 * n / ids.length) + '%';
      var lbl = el.querySelector('em'); if (lbl) lbl.textContent = n + ' / ' + ids.length;
    });
    document.querySelectorAll('[data-done-btn]').forEach(function (b) {
      var on = done.indexOf(b.dataset.doneBtn) > -1; b.setAttribute('aria-pressed', String(on));
      b.textContent = on ? b.dataset.on : b.dataset.off;
    });
  }
  document.addEventListener('click', function (e) {
    var a = e.target.closest('a[data-complete]');
    if (a) { completed(a.dataset.complete); return; }
    var b = e.target.closest('button'); if (!b) return;
    if (b.dataset.doneBtn) {
      var id = b.dataset.doneBtn, i = done.indexOf(id);
      if (i > -1) { done.splice(i, 1); save(KEY, done); } else completed(id);
      paint();
    } else if (b.dataset.tab) {
      var box = b.closest('[data-tabs]');
      box.querySelectorAll('[data-tab]').forEach(function (x) { x.setAttribute('aria-selected', String(x === b)); });
      box.querySelectorAll('.tab-panel').forEach(function (p) { p.hidden = p.id !== b.dataset.tab; });
    } else if (b.dataset.pick) {
      var card = b.closest('[data-answer]'), ok = b.dataset.pick === card.dataset.answer;
      card.querySelectorAll('[data-pick]').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      var fb = card.querySelector('.fb'); fb.hidden = false;
      fb.querySelector('b').textContent = ok ? card.dataset.ok : card.dataset.again;
    } else if (b.hasAttribute('data-print')) {
      if (b.dataset.completeSlug) { completed(b.dataset.completeId); completed(b.dataset.completeId, b.dataset.completeSlug); }
      window.print();
    } else if (b.hasAttribute('data-clear')) {
      var f = b.closest('[data-store]'); try { localStorage.removeItem(f.dataset.store); } catch (x) {}
      f.querySelectorAll('input,textarea').forEach(function (el) {
        if (el.type === 'checkbox') el.checked = el.defaultChecked; else el.value = el.defaultValue;
      });
    } else if (b.hasAttribute('data-share')) {
      if (navigator.share) navigator.share({ title: document.title, url: location.href }).catch(function () {});
    }
  });
  document.querySelectorAll('[data-store]').forEach(function (f) {
    var k = f.dataset.store, st = load(k, {});
    f.querySelectorAll('input,textarea').forEach(function (el) {
      if (st[el.name] !== undefined) { if (el.type === 'checkbox') el.checked = st[el.name]; else el.value = st[el.name]; }
    });
    f.addEventListener('input', function () {
      var o = {}; f.querySelectorAll('input,textarea').forEach(function (el) { o[el.name] = el.type === 'checkbox' ? el.checked : el.value; });
      save(k, o);
    });
  });
  document.querySelectorAll('[data-tabs]').forEach(function (box) {
    var first = box.querySelector('[data-tab]'); if (first) first.click();
  });
  document.querySelectorAll('[data-share]').forEach(function (b) { b.hidden = !navigator.share; });
  paint();
});
</script>

---
// Fills every [data-count] line on the page from GET /counts. Silent on any failure.
import { METRICS_URL, COUNTER_SHOW_FROM } from '../../config/site';
---
{METRICS_URL && (
  <script is:inline define:vars={{ url: METRICS_URL, min: COUNTER_SHOW_FROM }}>
    (function (run) { if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run(); })(function () {
      var els = document.querySelectorAll('[data-count]'); if (!els.length || !window.fetch) return;
      fetch(url + '/counts', { mode: 'cors' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
        if (!d) return;
        els.forEach(function (el) {
          var n = el.dataset.count === 'started' ? d.started : (d.started_by_track || {})[el.dataset.slug];
          if (typeof n !== 'number' || n < min) return;
          el.querySelector('.ns-count-n').textContent = el.dataset.tpl.replace('{n}', n.toLocaleString('en-IN'));
          el.hidden = false;
        });
      }).catch(function () {});
    });
  </script>
)}

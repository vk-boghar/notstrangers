---
// Unit visual: one dot = `per` registered cases. Drawn with an SVG <pattern> (a few hundred bytes,
// not one element per dot). Fills top-to-bottom on scroll; static and fully filled without JS or
// with reduced motion. Honest: a picture of an annual total, not a live ticker.
interface Props { total: number; per: number; ariaLabel: string; cols?: number }
const { total, per, ariaLabel, cols = 25 } = Astro.props;
const n = Math.round(total / per);
const g = 12, r = 3.6;
const full = Math.floor(n / cols), rest = n % cols;
const W = cols * g, H = Math.ceil(n / cols) * g;
const shape = (fill: string) => (
  `<rect x="0" y="0" width="${W}" height="${full * g}" fill="url(#${fill})"/>` +
  (rest ? `<rect x="0" y="${full * g}" width="${rest * g}" height="${g}" fill="url(#${fill})"/>` : '')
);
---
<figure class="chart dotgrid" data-dotgrid>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel} style={`max-width:${W * 1.25}px`}>
    <defs>
      <pattern id="dg-off" width={g} height={g} patternUnits="userSpaceOnUse"><circle cx={g / 2} cy={g / 2} r={r} fill="var(--c-dot-off)" /></pattern>
      <pattern id="dg-on" width={g} height={g} patternUnits="userSpaceOnUse"><circle cx={g / 2} cy={g / 2} r={r} fill="var(--c-seq)" /></pattern>
      <clipPath id="dg-clip"><rect class="dg-reveal" x="0" y="0" width={W} height={H} /></clipPath>
    </defs>
    <g set:html={shape('dg-off')} />
    <g clip-path="url(#dg-clip)" set:html={shape('dg-on')} />
  </svg>
  <figcaption class="small muted"><slot /></figcaption>
</figure>
<style>
  .dotgrid { margin: 1.5rem 0 0.5rem; }
  .dotgrid svg { margin: 0 auto 0.5rem 0; }
  :global(.js) .dotgrid .dg-reveal { transform: scaleY(0); transform-origin: top; transform-box: fill-box; transition: transform 2.4s cubic-bezier(.3,.1,.3,1); }
  :global(.js) .dotgrid.in .dg-reveal { transform: scaleY(1); }
  @media (prefers-reduced-motion: reduce) { :global(.js) .dotgrid .dg-reveal { transform: none; transition: none; } }
</style>
<script is:inline>
  (function () {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.classList.add('js');
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: 0.25 });
    document.querySelectorAll('[data-dotgrid]').forEach(function (el) { io.observe(el); });
  })();
</script>

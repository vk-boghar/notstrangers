---
// One 100% stacked bar + a legend that doubles as direct labels (identity never colour-alone).
export interface Seg { key: string; label: string; value: number; color: string }
interface Props { segs: Seg[]; ariaLabel: string; bracket?: { from: number; to: number; label: string } }
const { segs, ariaLabel, bracket } = Astro.props;
const total = segs.reduce((s, x) => s + x.value, 0);
const p = (v: number) => (v / total) * 100;
let acc = 0;
const starts = segs.map((s) => { const a = acc; acc += p(s.value); return a; });
---
<div class="chart stack" role="img" aria-label={ariaLabel}>
  {bracket && (
    <div class="bracket" style={`margin-left:${starts[bracket.from]}%;width:${starts[bracket.to] + p(segs[bracket.to].value) - starts[bracket.from]}%`}>
      <span>{bracket.label}</span>
    </div>
  )}
  <div class="bar">
    {segs.map((s) => <div class="seg" style={`width:${p(s.value)}%;background:${s.color}`} title={`${s.label}: ${p(s.value).toFixed(1)}%`}></div>)}
  </div>
  <ul class="legend">
    {segs.map((s) => (
      <li>
        <span class="sw" style={`background:${s.color}`}></span>
        <span class="l">{s.label}</span>
        <span class="n num"><strong>{p(s.value).toFixed(1)}%</strong><span>{new Intl.NumberFormat('en-IN').format(s.value)}</span></span>
      </li>
    ))}
  </ul>
</div>
<style>
  .bar { display: flex; gap: 2px; height: 44px; border-radius: 8px; overflow: hidden; }
  .seg { height: 100%; min-width: 3px; }
  .bracket { border: 2px solid var(--ink); border-bottom: 0; height: 12px; margin-bottom: 6px; position: relative; border-radius: 4px 4px 0 0; }
  .bracket span { position: absolute; bottom: 14px; left: 0; font-size: 0.8125rem; font-weight: 700; white-space: nowrap; }
  .stack { padding-top: 1.6rem; }
  .legend { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; }
  .legend li { display: grid; grid-template-columns: 14px minmax(0, 1fr) auto; column-gap: 12px; align-items: start; font-size: 0.9375rem; line-height: 1.4; padding: 12px 0; border-top: 1px solid var(--line-soft); }
  .sw { width: 12px; height: 12px; border-radius: 3px; margin-top: 5px; }
  .n { text-align: right; white-space: nowrap; }
  .n strong { display: block; font-size: 0.9375rem; }
  .n span { display: block; font-size: 0.75rem; color: var(--muted); }
</style>

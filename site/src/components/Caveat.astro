---
import { useT } from '../i18n';
import type { Lang } from '../config/site';
interface Props { lang: Lang; text?: string }
const { lang, text } = Astro.props;
const { t } = useT(lang);
---
<p class="caveat"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" style="flex:none;margin-top:3px"><circle cx="9" cy="9" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="8.2" y="7.5" width="1.6" height="5.5" rx=".8" fill="currentColor"/><circle cx="9" cy="5.2" r="1" fill="currentColor"/></svg><span>{text ?? t('common.reported_caveat')}</span></p>

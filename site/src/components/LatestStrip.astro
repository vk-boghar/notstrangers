---
// "Latest data" strip (spec §3.8): the freshest Tier 1/2 figure per topic, with its date, so the
// site never looks stale even though NCRB lags ~18 months. Tier 3 is never used here.
import { where, fmtInt, pct, lakh, periodLabel, type Row } from '../lib/data';
import { useT } from '../i18n';
import type { Lang } from '../config/site';
import TierTag from './TierTag.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);

const freshest = (rows: Row[]) => rows.filter((r) => r.tier <= 2).sort((a, b) => b.as_of_date.localeCompare(a.as_of_date))[0];

type Item = { key: string; value: string; row: Row };
const items: Item[] = [];
const relTotal = freshest(where({ dataset: 'pocso_relationship', geo: 'IN', dim: 'total' }));
if (relTotal) {
  const known = where({ dataset: 'pocso_relationship', geo: 'IN', dim: 'known_total', year: relTotal.year })[0];
  if (known) items.push({ key: 'who', value: `${pct(known.value, relTotal.value)}%`, row: known });
}
const add = (key: string, rows: Row[], f: (r: Row) => string = (r) => fmtInt(r.value)) => { const r = freshest(rows); if (r) items.push({ key, value: f(r), row: r }); };
add('scale', where({ dataset: 'pocso_total', geo: 'IN', metric: 'cases' }));
add('tn', where({ dataset: 'tn_pocso_registered', geo: 'TN' }));
add('tn_courts', where({ dataset: 'court_pendency', geo: 'TN', dim: 'pending_trial' }));
add('ftsc', where({ dataset: 'ftsc_flow', geo: 'IN', dim: 'pending_end_year' }));
add('online', where({ dataset: 'ncmec_reports', geo: 'IN' }), (r) => (lang === 'ta' ? lakh(r.value).replace('lakh', 'லட்சம்') : lakh(r.value)));
---
<section class="strip" aria-labelledby="strip-h">
  <div class="wrap-wide">
    <div class="head">
      <h2 id="strip-h" class="h">{t('strip.title')}</h2>
      <p class="small muted sub">{t('strip.sub')}</p>
    </div>
    <ul>
      {items.map((it) => (
        <li>
          <span class="v num">{it.value}</span>
          <span class="k">{t(`strip.${it.key}`)}</span>
          <span class="d muted"><a href={it.row.source_url} rel="noopener external" target="_blank">{periodLabel(it.row, lang)}</a> <TierTag tier={it.row.tier} lang={lang} /></span>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .strip { padding: 0 0 clamp(48px, 8vw, 96px); }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .h { font-family: var(--mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0; }
  :global(:lang(ta)) .h { font-family: var(--font); letter-spacing: 0; text-transform: none; font-size: 0.875rem; }
  .sub { margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  li { min-width: 0; display: flex; flex-direction: column; gap: 6px; background: var(--surface); padding: 18px 18px 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 0 -1px -1px 0; }
  .v { font-size: 1.65rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
  .k { font-size: 0.875rem; line-height: 1.4; color: var(--ink-2); }
  .d { margin-top: auto; padding-top: 8px; font-family: var(--mono); font-size: 0.6875rem; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  :global(:lang(ta)) .d { font-family: var(--font); font-size: 0.75rem; }
  .d a { color: var(--muted); }
</style>

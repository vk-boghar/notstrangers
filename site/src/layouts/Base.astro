---
// Self-hosted fonts only (no third-party requests): Public Sans for text, IBM Plex Mono for
// source lines and labels, Noto Sans Tamil for Tamil. Latin + Tamil subsets only.
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-500.css';
import '@fontsource/public-sans/latin-600.css';
import '@fontsource/public-sans/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/noto-sans-tamil/tamil-400.css';
import '@fontsource/noto-sans-tamil/tamil-600.css';
import '../styles/global.css';
import ps400 from '@fontsource/public-sans/files/public-sans-latin-400-normal.woff2?url';
import ps600 from '@fontsource/public-sans/files/public-sans-latin-600-normal.woff2?url';
import tamil400 from '@fontsource/noto-sans-tamil/files/noto-sans-tamil-tamil-400-normal.woff2?url';
import tamil600 from '@fontsource/noto-sans-tamil/files/noto-sans-tamil-tamil-600-normal.woff2?url';
import {
  SITE_NAME, SITE_NAME_TA, SITE_URL, NOINDEX, TAMIL_REVIEWED, CONTACT_EMAIL, type Lang,
} from '../config/site';
import { useT, otherLang, swapLangPath } from '../i18n';
import { META, fmtDate } from '../lib/data';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Page body is English-only for now (e.g. methodology) — show a note on the Tamil version. */
  englishOnly?: boolean;
  ogImage?: string;
}
const { lang, title, description, englishOnly = false, ogImage } = Astro.props;
const { t } = useT(lang);
const name = lang === 'ta' ? SITE_NAME_TA : SITE_NAME;
const fullTitle = title ? `${title} · ${name}` : name;
const desc = description ?? t('meta.description');
const path = Astro.url.pathname;
const alt = otherLang(lang);
const altHref = swapLangPath(path, alt);
const enHref = swapLangPath(path, 'en');
const taHref = swapLangPath(path, 'ta');
const canonical = new URL(path, SITE_URL).href;
const og = new URL(ogImage ?? `/share/${lang}/hook-1200x630.png`, SITE_URL).href;
const nav = [
  ['home', `/${lang}/`],
  ['learn', `/${lang}/learn/`],
  ['india', `/${lang}/explore/india/`],
  ['tn', `/${lang}/explore/tamil-nadu/`],
  ['guide', `/${lang}/guide/`],
  ['help', `/${lang}/help/`],
  ['method', `/${lang}/methodology/`],
  ['data', `/${lang}/data/`],
  ['about', `/${lang}/about/`],
] as const;
const preload = lang === 'ta' ? [tamil400, tamil600, ps400] : [ps400, ps600];
const isCurrent = (href: string) => (href === `/${lang}/` ? path === href : path.startsWith(href));
---
<!doctype html>
<html lang={lang === 'ta' ? 'ta-IN' : 'en-IN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {NOINDEX && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'en' ? 'en-IN' : 'ta-IN'} href={canonical} />
    <link rel="alternate" hreflang={alt === 'en' ? 'en-IN' : 'ta-IN'} href={new URL(altHref, SITE_URL).href} />
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#fbf9f5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ta' ? 'ta_IN' : 'en_IN'} />
    <meta name="twitter:card" content="summary_large_image" />
    {preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="referrer" content="no-referrer" />
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    {NOINDEX && <div class="banner banner-preview" role="note">{t('banner.preview')}</div>}

    <header class="site-header">
      <div class="wrap-wide bar">
        <a class="brand" href={`/${lang}/`}>
          <span class="logo" aria-hidden="true"></span>
          <span>{name}</span>
        </a>
        <div class="lang" role="group" aria-label={t('lang.switch_label')}>
          <a href={enHref} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} aria-label="English">EN</a>
          <a href={taHref} hreflang="ta" lang="ta" aria-current={lang === 'ta' ? 'true' : undefined} aria-label="தமிழ் (Tamil)">த</a>
        </div>
        <nav aria-label="Main">
          <ul>
            {nav.map(([k, href]) => (
              <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{t(`nav.${k}`)}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      {lang === 'ta' && !TAMIL_REVIEWED && <div class="banner banner-ta" role="note">{t('banner.ta_draft')}</div>}
    </header>

    <main id="main">
      {englishOnly && lang === 'ta' && (
        <div class="wrap"><p class="en-only"><span class="draft">{t('banner.ta_pending')}</span> இந்தப் பக்கம் தற்போது ஆங்கிலத்தில் மட்டும் உள்ளது.</p></div>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap-wide foot">
        <div class="foot-main">
          <p class="brand-f"><span class="logo" aria-hidden="true"></span><strong>{name}</strong></p>
          <p>{t('footer.noncommercial')} {t('footer.no_cases')}</p>
          <p>{lang === 'ta' ? 'அவசரம்:' : 'In an emergency call'} <a href="tel:112" class="num">112</a>{lang === 'ta' ? '; குழந்தைகள் உதவி எண்' : '; for a child in need of care,'} <a href="tel:1098" class="num">1098</a>.</p>
          <p class="mono-line">
            {t('footer.error')} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            · {t('footer.updated')}: <span class="num">{fmtDate(META.generated_on, lang)}</span>
          </p>
        </div>
        <ul class="foot-links">
          {nav.map(([k, href]) => <li><a href={href}>{t(`nav.${k}`)}</a></li>)}
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .banner { font-size: 0.8125rem; text-align: center; padding: 8px var(--gutter); }
  .banner-preview { background: var(--ink); color: var(--bg); }
  .banner-ta { background: var(--warm-bg); color: var(--ink); border-top: 1px solid var(--warm-line); }
  .site-header {
    position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--line);
    background: color-mix(in oklch, var(--bg) 92%, transparent);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 20px; padding-top: 10px; padding-bottom: 6px; }
  .brand { display: inline-flex; align-items: center; gap: 0; font-weight: 700; font-size: 1rem; letter-spacing: -0.01em; color: var(--ink); text-decoration: none; padding: 6px 0; }
  .logo { display: inline-block; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); box-shadow: 18px 0 0 -3px var(--c-friends); margin-right: 20px; flex: none; }
  .lang { margin-left: auto; display: flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; }
  .lang a {
    min-width: 40px; min-height: 32px; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px; padding: 4px 12px; font-size: 0.8125rem; font-weight: 600; color: var(--muted); text-decoration: none;
  }
  .lang a[aria-current='true'] { background: var(--ink); color: var(--bg); }
  nav { order: 3; flex: 1 1 100%; margin: 0 -4px; overflow-x: auto; scrollbar-width: none; -webkit-mask-image: linear-gradient(90deg, #000 92%, transparent); mask-image: linear-gradient(90deg, #000 92%, transparent); }
  nav::-webkit-scrollbar { display: none; }
  nav ul { list-style: none; display: flex; gap: 4px; margin: 0; padding: 2px 4px 4px; }
  nav li { flex: none; }
  nav a {
    display: inline-flex; align-items: center; min-height: 40px; padding: 8px 14px; border-radius: 999px;
    font-size: 0.875rem; font-weight: 500; color: var(--muted); text-decoration: none; white-space: nowrap;
  }
  nav a:hover { background: var(--track); color: var(--ink); }
  nav a[aria-current='page'] { background: var(--accent-soft); color: var(--accent-soft-ink); }
  @media (min-width: 1100px) {
    nav { mask-image: none; -webkit-mask-image: none; }
  }
  .site-footer { border-top: 1px solid var(--line); background: var(--band); font-size: 0.875rem; line-height: 1.6; color: var(--ink-2); }
  .foot { display: flex; flex-wrap: wrap; gap: 16px 48px; justify-content: space-between; padding-top: 32px; padding-bottom: 40px; }
  .foot-main { max-width: 60ch; }
  .foot-main p { margin: 0 0 0.6rem; }
  .brand-f { display: flex; align-items: center; color: var(--ink); }
  .mono-line { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
  :global(:lang(ta)) .mono-line { font-family: var(--font); }
  .foot-links { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, auto); gap: 4px 24px; align-content: start; }
  .foot-links a { color: var(--link); }
  .en-only { margin-top: 1.25rem; font-size: 0.9rem; }
</style>

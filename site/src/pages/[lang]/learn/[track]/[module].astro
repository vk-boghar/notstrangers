---
import Base from '../../../../layouts/Base.astro';
import LearnKit from '../../../../components/learn/LearnKit.astro';
import Count from '../../../../components/learn/Count.astro';
import { LANGS, SITE_URL, type Lang } from '../../../../config/site';
import { modulesFor, tracksFor, byTrackL, uiFor, planFor, rich, isVisible, type Module } from '../../../../lib/learn';
import { one, latestYear, fmtInt } from '../../../../lib/data';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => modulesFor(lang).filter((m) => isVisible(m.track)).map((m) => ({ params: { lang, track: m.track, module: m.id }, props: { m } })));
}
const lang = Astro.params.lang as Lang;
const { m } = Astro.props as { m: Module };
const U = uiFor(lang);
const PLAN = planFor(lang);
const T = tracksFor(lang)[m.track];
const mods = byTrackL(lang, m.track);
const idx = mods.findIndex((x) => x.id === m.id);
const prev = mods[idx - 1], next = mods[idx + 1];
const NOUN = { parent: 'parents', kid: 'kids', teen: 'teens' } as const;
const mslug = `${NOUN[m.track]}-${m.id.slice(1).padStart(2, '0')}`;
const base = `/${lang}/learn/${m.track}/`;

// KPI hooks use the live dataset, never a typed-in number.
const relYear = latestYear('pocso_relationship', 'IN')!;
const relTotal = one({ dataset: 'pocso_relationship', geo: 'IN', year: relYear, dim: 'total' });
const relKnown = one({ dataset: 'pocso_relationship', geo: 'IN', year: relYear, dim: 'known_total' });
const known = String(Math.round((relKnown.value / relTotal.value) * 100));
const fill = (s?: string) => (s ?? '').replaceAll('{known}', known);
const shareUrl = `${SITE_URL}${base}${m.id}/`;
const hookLabel = U.hook[m.hook.kind];
---
<Base lang={lang} title={`${m.title} · ${T.door}`} description={fill(m.hook.text).replace(/\*\*/g, '')}>
  <div class="wrap page mod-page">
    <LearnKit lang={lang} />
    <article class:list={['mod', `track-${m.track}`]}>
      <nav class="crumb" aria-label="Breadcrumb"><a href={`/${lang}/learn/`}>{U.learn}</a> / <a href={base}>{T.door}</a> / {U.moduleOf(idx + 1, mods.length)}</nav>
      <div class="meta">
        <span class="chip">{m.minutes} {U.min}</span>
       
        <div class="prog js-only" data-progress={mods.map((x) => x.id).join(',')}><b><i></i></b><em>0 / {mods.length}</em></div>
      </div>
      <h1>{m.title}</h1>

      <!-- 1 Hook -->
      <section class:list={['hook', `hook-${m.hook.kind}`]} aria-label="Hook">
        {hookLabel && <p class="beat">{hookLabel}</p>}
        {m.hook.kind === 'kpi' ? (
          <div class="kpi">
            <div class="kpi-num"><span class="num">{known}</span><span class="of">{U.ofHundred}</span></div>
            <div>
              <p class="kpi-text" set:html={rich(fill(m.hook.text))} />
              {m.hook.meaning && <p class="kpi-meaning"><b>{U.meaning}</b> {fill(m.hook.meaning)}</p>}
              {m.hook.action && <p class="kpi-action"><b>{U.action}</b> {fill(m.hook.action)}</p>}
              <p class="kpi-src">{U.kpiSrc(relYear, fmtInt(relKnown.value), fmtInt(relTotal.value))}</p>
            </div>
          </div>
        ) : <p class="hook-text" set:html={rich(fill(m.hook.text))} />}
      </section>

      <!-- 2 Learn -->
      <section class="beat-sec" aria-labelledby={`${m.id}-learn`}>
        <h2 id={`${m.id}-learn`} class="beat">{m.builder === 'plan' ? U.buildH : U.learnH}</h2>
        {m.learn.map((b, bi) => {
          if (b.type === 'p') return <p class="lp" set:html={rich(b.text)} />;
          if (b.type === 'list') return <ul class="ll">{b.items.map((i) => <li set:html={rich(i)} />)}</ul>;
          if (b.type === 'rules') return <ol class="rules">{b.items.map((r, i) => <li><span class="rn">{m.track === 'kid' && m.id === 'k3' ? '' : i + 1}</span><strong>{r.t}</strong><span set:html={rich(r.b)} /></li>)}</ol>;
          if (b.type === 'steps') return <ol class="steps">{b.items.map((r, i) => <li><span class="sn">{i + 1}</span><div><strong>{r.t}</strong><p set:html={rich(r.b)} /></div></li>)}</ol>;
          if (b.type === 'callout') return <div class:list={['callout', b.tone]}><strong>{b.title}</strong><ul>{b.items.map((i) => <li set:html={rich(i)} />)}</ul></div>;
          if (b.type === 'tabs') return (
            <div class="tabs" data-tabs>
              <div class="seg-ctl js-only" role="tablist" aria-label={U.ageBand}>
                {b.items.map((t, i) => <button type="button" role="tab" data-tab={`${m.id}-t${bi}-${i}`} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>)}
              </div>
              {b.items.map((t, i) => (
                <div class="tab-panel" id={`${m.id}-t${bi}-${i}`} role="tabpanel">
                  <p class="tab-h">{U.ages} {t.label}</p>
                  <p set:html={rich(t.text)} />
                  <blockquote class="say-q">{t.say}</blockquote>
                </div>
              ))}
            </div>
          );
          return null;
        })}
      </section>

      <!-- Interactive -->
      {m.game && (
        <section class="beat-sec game" aria-labelledby={`${m.id}-game`}>
          <h2 id={`${m.id}-game`} class="beat">{U.tryIt}</h2>
          <p class="game-p">{m.game.prompt}</p>
          <div class="cards">
            {m.game.cards.map((c) => (
              <div class="gcard" data-answer={c.answer} data-ok={U.ok} data-again={U.again}>
                <p class="gq">{c.text}</p>
                <div class="gbtns js-only">
                  <button type="button" data-pick="a" aria-pressed="false">{m.game!.a}</button>
                  <button type="button" data-pick="b" aria-pressed="false">{m.game!.b}</button>
                </div>
                <p class="fb" hidden><b></b>{c.fb}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {m.builder === 'trusted' && (
        <section class="beat-sec builder printable" data-store="ns-trusted-v1" aria-labelledby="tb-h">
          <h2 id="tb-h" class="beat">{U.trustedH}</h2>
          <p class="print-only print-title">{U.trustedH}</p>
          <p class="hint no-print">{U.trustedHint}</p>
          {[1, 2, 3].map((i) => (
            <label class="row"><span class="rl">{i}</span><input name={`t${i}`} type="text" autocomplete="off" placeholder={i === 3 ? U.outside : U.name} /></label>
          ))}
          <p class="card-rules">{U.cardRules}</p>
          <p class="card-rules" set:html={U.cardNums} />
          <p class="stay no-print">{U.savedDevice}</p>
          <div class="bbtns js-only no-print"><button type="button" class="btn primary" data-print>{U.printCard}</button><button type="button" class="btn" data-clear>{U.clear}</button></div>
        </section>
      )}

      {m.builder === 'plan' && (
        <section class="beat-sec builder printable plan" data-store="ns-plan-v1" aria-labelledby="plan-h">
          <h2 id="plan-h" class="beat no-print">{U.planH}</h2>
          <p class="print-only print-title">{U.planPrint}</p>
          <fieldset>
            <legend>{U.legends[0]}</legend>
            {PLAN.rules.map((r, i) => <label class="row"><span class="rl">{i + 1}</span><input name={`r${i}`} type="text" value={r} /></label>)}
          </fieldset>
          <fieldset>
            <legend>{U.legends[1]}</legend>
            <p class="hint no-print">{U.trustedAdultsHint}</p>
            {[1, 2, 3, 4, 5].map((i) => (
              <div class="row two"><span class="rl">{i}</span><input name={`a${i}`} type="text" autocomplete="off" placeholder={U.name} aria-label={`${U.trustedAria(i)} · ${U.name}`} /><input name={`p${i}`} type="tel" autocomplete="off" placeholder={U.phone} aria-label={`${U.trustedAria(i)} · ${U.phone}`} /></div>
            ))}
          </fieldset>
          <fieldset>
            <legend>{U.legends[2]}</legend>
            {PLAN.online.map((r, i) => <label class="check"><input type="checkbox" name={`o${i}`} checked /> <span>{r}</span></label>)}
            <label class="row"><span class="rl">+</span><input name="o_own" type="text" placeholder={U.addOwn} /></label>
          </fieldset>
          <fieldset>
            <legend>{U.legends[3]}</legend>
            <textarea name="promise" rows="2">{PLAN.promise}</textarea>
          </fieldset>
          <fieldset class="nums">
            <legend>{U.legends[4]}</legend>
            <p set:html={U.nums} />
          </fieldset>
          <p class="print-only foot-print">{U.revisit}</p>
          <p class="stay no-print">{U.savedNever}</p>
          <div class="bbtns js-only no-print"><button type="button" class="btn primary" data-print data-complete-id="p8" data-complete-slug="family-safety-plan">{U.printPlan}</button><button type="button" class="btn" data-clear>{U.clear}</button></div>
          <p class="done-msg no-print">{U.doneMsg}</p>
        </section>
      )}

      <!-- 3 Say it -->
      {m.say && (
        <section class="beat-sec" aria-labelledby={`${m.id}-say`}>
          <h2 id={`${m.id}-say`} class="beat">{m.sayTitle ?? U.say}</h2>
          {m.say.map((s) => <blockquote class="say-q">{s}</blockquote>)}
        </section>
      )}

      <!-- 4 Do it -->
      <section class="doit" aria-labelledby={`${m.id}-do`}>
        <h2 id={`${m.id}-do`} class="beat">{U.doIt}</h2>
        <p set:html={rich(m.doIt)} />
        {m.share && (
          <p class="share-row">
            <a class="btn sm" href={`https://wa.me/?text=${encodeURIComponent(`${m.title}: ${shareUrl}`)}`} rel="noopener external" target="_blank">{U.whatsapp}</a>
            <button type="button" class="btn sm" data-share hidden>{U.shareBtn}</button>
          </p>
        )}
      </section>

      <!-- 5 Check -->
      {m.checks.length > 0 && (
        <section class="beat-sec" aria-labelledby={`${m.id}-check`}>
          <h2 id={`${m.id}-check`} class="beat">{U.check}</h2>
          <p class="muted small">{U.checkHint}</p>
          {m.checks.map((c) => (
            <details class="check-q">
              <summary>{c.q}</summary>
              <p>{c.a}</p>
            </details>
          ))}
        </section>
      )}

      <div class="finish no-print">
        <button type="button" class="btn primary js-only" data-done-btn={m.id} data-off={U.markDone} data-on={U.done} aria-pressed="false">{U.markDone}</button>
        <Count lang={lang} kind="module" slug={mslug} noun={NOUN[m.track]} />
        <div class="pn">
          {prev ? <a class="btn" href={`${base}${prev.id}/`}>← {prev.title}</a> : <a class="btn" href={base}>← {U.all}</a>}
          {next ? <a class="btn" data-complete={m.id} href={`${base}${next.id}/`}>{U.next} {next.title} →</a> : <a class="btn" data-complete={m.id} href={`/${lang}/learn/`}>{U.back} →</a>}
        </div>
      </div>
    </article>
  </div>
</Base>

<style>
  .mod-page { max-width: calc(780px + 2 * var(--gutter)); }
  .crumb { font-size: 0.875rem; color: var(--muted); margin-bottom: 16px; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 14px; }
  .meta .prog { flex: 1 1 160px; max-width: 260px; color: var(--accent); }
  .chip { font-family: var(--mono); font-size: 0.75rem; border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; color: var(--muted); }
  h1 { margin-bottom: 24px; }
  .beat { font-family: var(--mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--link); margin: 0 0 12px; }
  .beat-sec { margin-top: 40px; }

  .hook { border-radius: 20px; padding: clamp(20px, 4vw, 32px); }
  .hook-kpi, .hook-statement { background: var(--accent); color: var(--on-accent); }
  .hook-kpi .beat, .hook-statement .beat { color: inherit; opacity: 0.85; }
  .hook-scenario { background: var(--warm-bg); border: 1px solid var(--warm-line); }
  .hook-scenario .beat { color: var(--warm-ink); }
  .hook-plain { background: var(--accent-soft); color: var(--accent-soft-ink); }
  .hook-text { font-size: clamp(1.3rem, 3vw, 1.75rem); line-height: 1.35; font-weight: 500; margin: 0; letter-spacing: -0.01em; }
  .track-kid .hook-text { font-size: clamp(1.5rem, 4vw, 2.2rem); }
  .kpi { display: grid; grid-template-columns: auto 1fr; gap: 24px; align-items: start; }
  @media (max-width: 520px) { .kpi { grid-template-columns: 1fr; gap: 10px; } }
  .kpi-num { display: flex; flex-direction: column; line-height: 1; }
  .kpi-num .num { font-size: clamp(4rem, 12vw, 6rem); font-weight: 600; letter-spacing: -0.04em; }
  .of { font-size: 0.9rem; opacity: 0.85; }
  .kpi-text { font-size: clamp(1.1rem, 2.4vw, 1.3rem); line-height: 1.4; font-weight: 500; margin-bottom: 12px; }
  .kpi-meaning, .kpi-action { margin: 0 0 8px; font-size: 1rem; }
  .kpi-src { margin: 12px 0 0; font-family: var(--mono); font-size: 0.72rem; opacity: 0.8; }

  .lp { font-size: 1.0625rem; }
  .ll { padding-left: 1.2rem; display: grid; gap: 12px; font-size: 1.0625rem; margin: 0; }
  .rules { list-style: none; padding: 0; margin: 0 0 16px; display: grid; gap: 10px; }
  .rules li { display: grid; grid-template-columns: 40px 1fr; column-gap: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; }
  .rn { grid-row: span 2; width: 36px; height: 36px; border-radius: 10px; background: var(--accent); color: var(--on-accent); display: grid; place-items: center; font-weight: 700; }
  .rn:empty { display: none; }
  .rules li:has(.rn:empty) { grid-template-columns: 1fr; }
  .rules strong { font-size: 1.05rem; }
  .rules li > span:last-child { color: var(--ink-2); font-size: 0.9375rem; }
  .track-kid .rules strong { font-size: 1.5rem; letter-spacing: -0.01em; }
  .steps { list-style: none; margin: 16px 0; padding: 0; }
  .steps li { display: grid; grid-template-columns: 36px 1fr; gap: 14px; padding-bottom: 16px; position: relative; }
  .steps li:not(:last-child)::after { content: ''; position: absolute; left: 17px; top: 36px; bottom: 0; border-left: 2px solid var(--line); }
  .sn { width: 36px; height: 36px; border-radius: 50%; border: 2px solid var(--accent); color: var(--link); background: var(--surface); display: grid; place-items: center; font-weight: 700; }
  .steps strong { display: block; margin: 6px 0 2px; }
  .steps p { margin: 0; color: var(--ink-2); font-size: 0.9375rem; }
  .callout { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; margin: 12px 0; }
  .callout.warm { background: var(--warm-bg); border-color: var(--warm-line); }
  .callout ul { margin: 8px 0 0; padding-left: 1.1rem; font-size: 0.9375rem; color: var(--ink-2); display: grid; gap: 4px; }

  .tabs .seg-ctl { margin-bottom: 14px; }
  .tab-panel { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 18px 20px; margin-bottom: 12px; }
  .tab-h { font-weight: 600; margin-bottom: 6px; }

  .say-q { margin: 0 0 12px; padding: 16px 20px; border-left: 4px solid var(--c-friends); background: var(--warm-bg); border-radius: 0 14px 14px 0; font-size: clamp(1.05rem, 2.2vw, 1.25rem); line-height: 1.45; font-weight: 500; }

  .game-p { font-weight: 600; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .gcard { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 18px; display: grid; gap: 12px; align-content: start; }
  .gq { margin: 0; font-size: 1.05rem; font-weight: 500; }
  .gbtns { display: flex; gap: 8px; flex-wrap: wrap; }
  .gbtns button { flex: 1 1 120px; min-height: 48px; border-radius: 12px; border: 2px solid var(--line); background: var(--bg); font: inherit; font-weight: 600; cursor: pointer; color: var(--ink); }
  .gbtns button[aria-pressed='true'] { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-soft-ink); }
  .fb { margin: 0; font-size: 0.9375rem; background: var(--band); border-radius: 10px; padding: 10px 12px; }

  .builder { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: clamp(18px, 4vw, 28px); }
  .builder fieldset { border: 0; padding: 0; margin: 0 0 22px; }
  .builder legend { font-weight: 600; font-size: 1.05rem; margin-bottom: 10px; }
  .row { display: grid; grid-template-columns: 28px 1fr; gap: 10px; align-items: center; margin-bottom: 8px; }
  .row.two { grid-template-columns: 28px 1.4fr 1fr; }
  .rl { font-family: var(--mono); color: var(--link); font-size: 0.875rem; }
  .builder input[type='text'], .builder input[type='tel'], .builder textarea { width: 100%; font: inherit; font-size: 1rem; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--ink); min-height: 44px; min-width: 0; }
  .builder textarea { resize: vertical; }
  .check { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 8px; }
  .check input { width: 20px; height: 20px; margin-top: 3px; accent-color: var(--accent); flex: none; }
  .hint { font-size: 0.875rem; color: var(--muted); margin-bottom: 10px; }
  .stay { font-size: 0.8125rem; color: var(--muted); margin: 8px 0; }
  .bbtns { display: flex; gap: 10px; flex-wrap: wrap; }
  .done-msg { margin: 16px 0 0; font-weight: 500; color: var(--link); }
  .card-rules { font-weight: 600; margin: 12px 0 0; }
  .nums p { margin: 0; }
  .print-only { display: none; }

  .doit { margin-top: 40px; background: var(--accent); color: var(--on-accent); border-radius: 20px; padding: clamp(20px, 4vw, 28px); }
  .doit .beat { color: inherit; opacity: 0.85; }
  .doit p { margin: 0; font-size: clamp(1.1rem, 2.4vw, 1.35rem); line-height: 1.4; font-weight: 500; }
  .doit .share-row { margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap; }
  .doit .btn { color: var(--on-accent); border-color: currentColor; }

  .check-q { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 0 18px; margin-bottom: 10px; }
  .check-q summary { cursor: pointer; padding: 16px 0; font-weight: 600; line-height: 1.45; list-style: none; position: relative; padding-right: 32px; }
  .check-q summary::-webkit-details-marker { display: none; }
  .check-q summary::after { content: '+'; position: absolute; right: 0; top: 14px; width: 24px; height: 24px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-soft-ink); display: grid; place-items: center; font-weight: 700; }
  .check-q[open] summary::after { content: '–'; }
  .check-q p { margin: 0 0 16px; padding: 12px 14px; background: var(--accent-soft); color: var(--accent-soft-ink); border-radius: 10px; }

  .finish { margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--line); display: grid; gap: 16px; justify-items: start; }
  .finish .pn { justify-self: stretch; }
  .finish [aria-pressed='true'] { background: var(--surface); color: var(--link); border-color: var(--accent); }
  .pn { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .pn .btn { max-width: 100%; }

  @media print {
    :global(body *) { visibility: hidden; }
    .printable, .printable :global(*) { visibility: visible; }
    .printable { position: absolute; left: 0; top: 0; width: 100%; border: 0; padding: 0 12mm; }
    .no-print, .js-only { display: none !important; }
    .print-only { display: block; }
    .print-title { font-size: 26pt; font-weight: 700; margin: 0 0 14pt; }
    .builder input[type='text'], .builder input[type='tel'], .builder textarea { border: 0; border-bottom: 1px solid #999; border-radius: 0; background: none; padding: 4pt 0; min-height: 0; resize: none; }
    :global(html), :global(body) { background: #fff !important; }
    .printable { background: #fff; }
    .builder input::placeholder { color: transparent; }
    .foot-print { margin-top: 18pt; font-size: 9pt; color: #555; }
  }
</style>

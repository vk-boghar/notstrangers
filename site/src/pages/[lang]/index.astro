---
import Base from '../../layouts/Base.astro';
import LatestStrip from '../../components/LatestStrip.astro';
import Cite from '../../components/Cite.astro';
import Caveat from '../../components/Caveat.astro';
import ActionCard from '../../components/ActionCard.astro';
import DataTable from '../../components/DataTable.astro';
import Helplines from '../../components/Helplines.astro';
import Share from '../../components/Share.astro';
import DotGrid from '../../components/charts/DotGrid.astro';
import BarList from '../../components/charts/BarList.astro';
import StackBar from '../../components/charts/StackBar.astro';
import RelationshipChart from '../../components/charts/RelationshipChart.astro';
import JusticeFunnel from '../../components/charts/JusticeFunnel.astro';
import { LANGS, PREVENTION_CONTENT_REVIEWED, type Lang } from '../../config/site';
import { useT } from '../../i18n';
import { one, maybe, where, latestYear, fmtInt, pct, daysInYear, periodLabel, fmtDate } from '../../lib/data';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const { t } = useT(lang);

// ── Section 1: hook ────────────────────────────────────────────────────────
const relYear = latestYear('pocso_relationship', 'IN')!;
const relTotal = one({ dataset: 'pocso_relationship', geo: 'IN', year: relYear, dim: 'total' });
const relKnown = one({ dataset: 'pocso_relationship', geo: 'IN', year: relYear, dim: 'known_total' });
const relFam = one({ dataset: 'pocso_relationship', geo: 'IN', year: relYear, dim: 'family_members' });
const relAdults = one({ dataset: 'pocso_relationship', geo: 'IN', year: relYear, dim: 'family_friends_neighbours_known' });
const knownPer100 = Math.round((relKnown.value / relTotal.value) * 100);

// ── Section 2: scale ───────────────────────────────────────────────────────
const sYear = latestYear('pocso_total', 'IN')!;
const pocso = one({ dataset: 'pocso_total', geo: 'IN', year: sYear, metric: 'cases' });
const days = daysInYear(sYear);
const perDay = Math.round(pocso.value / days / 10) * 10;         // "about 190"
const everyMins = Math.round((days * 24 * 60) / pocso.value);    // "~8"
const PER_DOT = 100;
const tn = maybe({ dataset: 'pocso_total', geo: 'TN', year: sYear, metric: 'cases' });

// ── Section 4: age ─────────────────────────────────────────────────────────
const aYear = latestYear('pocso_victims_age', 'IN')!;
const BANDS = ['lt6', '6_12', '12_16', '16_18'];
const ageRows = BANDS.map((b) => one({ dataset: 'pocso_victims_age', geo: 'IN', year: aYear, dim: b }));
const ageTotal = one({ dataset: 'pocso_victims_age', geo: 'IN', year: aYear, dim: 'total' }).value;
const teen = ageRows[2].value + ageRows[3].value;

// ── Section 5: justice ─────────────────────────────────────────────────────
const hcPending = one({ dataset: 'court_pendency', geo: 'TN', dim: 'pending_trial' });
const hcOver = one({ dataset: 'court_pendency', geo: 'TN', dim: 'pending_over_1yr' });
const vidhi = one({ dataset: 'trial_duration', geo: 'IN', metric: 'avg_days_to_dispose' });
const vidhiMonths = vidhi.value / (365.25 / 12);
const fYear = latestYear('ftsc_flow', 'IN')!;
const ftscYears = [...new Set(where({ dataset: 'ftsc_flow', geo: 'IN' }).map((r) => r.year))].sort();
const ftsc = (y: number, d: string) => one({ dataset: 'ftsc_flow', geo: 'IN', year: y, dim: d });
const ftscCourts = one({ dataset: 'ftsc_capacity', geo: 'IN', dim: 'all_ftsc' });
const ftscPocso = one({ dataset: 'ftsc_capacity', geo: 'IN', dim: 'exclusive_pocso' });
const courtYear = latestYear('pocso_court', 'IN');
const ACTIONS = [1, 2, 3, 4, 5, 6, 7];
---
<Base lang={lang}>
  <!-- 1 · Hook -->
  <section class="hook" aria-labelledby="hook-h">
    <div class="wrap">
      <p class="kicker">{t('home.hook_kicker')}</p>
      <h1 id="hook-h">{t('home.hook_title', { n: knownPer100 })}</h1>
      <p class="lead">{t('home.hook_sub')}</p>
      <figure class="waffle" aria-hidden="true">
        <svg viewBox="0 0 200 200" width="180" height="180">
          {Array.from({ length: 100 }, (_, i) => {
            const x = (i % 10) * 20 + 10, y = Math.floor(i / 10) * 20 + 10;
            return i < knownPer100
              ? <circle cx={x} cy={y} r="7" fill="var(--accent)" />
              : <circle cx={x} cy={y} r="6" fill="none" stroke="var(--muted)" stroke-width="2" />;
          })}
        </svg>
      </figure>
      <Cite rows={[relTotal, relKnown]} lang={lang} />
      <p class="small muted">{fmtInt(relKnown.value)} / {fmtInt(relTotal.value)} = {pct(relKnown.value, relTotal.value)}%, {lang === 'ta' ? 'அருகிலுள்ள முழு எண்ணுக்கு' : 'rounded to'} {knownPer100}.</p>
      <Share lang={lang} card="hook" text={t('home.hook_title', { n: knownPer100 })} />
      <p><a class="btn" href="#scale">{t('home.hook_scroll')} ↓</a></p>
    </div>
  </section>

  <LatestStrip lang={lang} />

  <!-- 2 · Scale -->
  <section class="section" id="scale" aria-labelledby="scale-h">
    <div class="wrap">
      <p class="kicker">{t('home.scale_kicker')}</p>
      <h2 id="scale-h">{t('home.scale_title', { year: sYear, total: fmtInt(pocso.value) })}</h2>
      <p class="lead">{t('home.scale_perday', { perday: perDay, mins: `~${everyMins}` })}</p>
      <Caveat lang={lang} />
      <DotGrid total={pocso.value} per={PER_DOT} ariaLabel={t('home.scale_dot_caption', { per: PER_DOT, dots: Math.round(pocso.value / PER_DOT) })}>
        {t('home.scale_dot_caption', { per: PER_DOT, dots: fmtInt(Math.round(pocso.value / PER_DOT)) })}
      </DotGrid>
      <Cite rows={pocso} lang={lang} csv="pocso_total" />
      {tn && (
        <div class="card tn">
          <p><strong>{t('home.scale_tn', { tn: fmtInt(tn.value), year: tn.year, perday: Math.round(tn.value / days) })}</strong></p>
          <p class="small muted">{t('home.scale_tn_note')}</p>
          <Cite rows={tn} lang={lang} csv="pocso_total" />
        </div>
      )}
      <p class="small">{t('home.scale_rising')}</p>
      <Share lang={lang} card="scale" text={t('cards.scale_stat', { perday: perDay, year: sYear })} />
    </div>
  </section>

  <!-- 3 · Who -->
  <section class="section" id="who" aria-labelledby="who-h">
    <div class="wrap">
      <p class="kicker">{t('home.who_kicker')}</p>
      <h2 id="who-h">{t('home.who_title')}</h2>
      <RelationshipChart lang={lang} />
      <Caveat lang={lang} />
      <div class="card explainer">
        <h3>{t('home.who_explainer_title')}</h3>
        <p>{t('home.who_explainer')}</p>
        <p>{t('home.who_explainer_2', { n: fmtInt(relFam.value + relAdults.value), year: relYear })}</p>
        <p class="small"><a href={`/${lang}/methodology/#relationship`}>{t('common.methodology_link')} →</a></p>
      </div>
      <ActionCard lang={lang} text={t('home.who_action')} />
    </div>
  </section>

  <!-- 4 · Age -->
  <section class="section" id="age" aria-labelledby="age-h">
    <div class="wrap">
      <p class="kicker">{t('home.age_kicker')}</p>
      <h2 id="age-h">{t('home.age_title')}</h2>
      <p class="lead">{t('home.age_lead', { year: aYear, share: pct(teen, ageTotal) })}</p>
      <BarList
        ariaLabel={`${aYear}: ${ageRows.map((r) => `${t(`home.age_band_${r.dimension_value}`)} ${fmtInt(r.value)}`).join('; ')}`}
        bars={ageRows.map((r) => ({
          label: t(`home.age_band_${r.dimension_value}`),
          value: r.value,
          valueLabel: `${fmtInt(r.value)} · ${pct(r.value, ageTotal)}%`,
          color: 'var(--c-seq)',
        }))}
      />
      <DataTable lang={lang} caption={`POCSO victims by age, ${aYear}`} head={[t('common.category'), t('common.victims'), t('common.share_pct')]} numeric={[1, 2]}
        rows={ageRows.map((r) => [t(`home.age_band_${r.dimension_value}`), fmtInt(r.value), `${pct(r.value, ageTotal)}%`])} />
      <Cite rows={ageRows} lang={lang} csv="pocso_victims_age" />
      <Caveat lang={lang} text={t('home.age_note')} />
      <ActionCard lang={lang} text={t('home.age_action')} />
    </div>
  </section>

  <!-- 5 · Justice -->
  <section class="section" id="justice" aria-labelledby="justice-h">
    <div class="wrap">
      <p class="kicker">{t('home.justice_kicker')}</p>
      <h2 id="justice-h">{t('home.justice_title')}</h2>
      <p class="lead">{t('home.justice_lead')}</p>

      <div class="card">
        <p class="takeaway">{t('home.justice_tn_callout', { pending: fmtInt(hcPending.value), over: fmtInt(hcOver.value) })}</p>
        <StackBar
          ariaLabel={`${fmtInt(hcOver.value)} of ${fmtInt(hcPending.value)} pending more than one year`}
          segs={[
            { key: 'over', label: lang === 'ta' ? 'ஓராண்டுக்கு மேல் காத்திருப்பவை' : 'Waiting more than 1 year', value: hcOver.value, color: 'var(--c-family)' },
            { key: 'under', label: lang === 'ta' ? 'ஓராண்டுக்குள்' : 'Waiting up to 1 year', value: hcPending.value - hcOver.value, color: 'var(--c-unknown)' },
          ]}
        />
        <Cite rows={[hcPending, hcOver]} lang={lang} csv="court_pendency" />
        <Share lang={lang} card="wait" text={t('cards.wait_stat', { pending: fmtInt(hcPending.value) })} />
      </div>

      <h3 class="sub-h">{t('home.justice_clock_title')}</h3>
      <BarList
        ariaLabel={`${t('home.justice_clock_limit')}: 12 months. ${t('home.justice_clock_actual')}: ${vidhiMonths.toFixed(1)} months.`}
        max={18}
        marker={{ at: 12, label: t('home.justice_clock_limit_val') }}
        bars={[
          { label: t('home.justice_clock_limit'), value: 12, valueLabel: t('home.justice_clock_limit_val'), color: 'var(--c-seq-soft)' },
          { label: t('home.justice_clock_actual'), value: vidhiMonths, valueLabel: t('home.justice_clock_actual_val', { months: Math.round(vidhiMonths) }), color: 'var(--c-family)', emphasis: true },
        ]}
      />
      <p class="small muted">{t('home.justice_clock_note')} ({fmtInt(Math.round(vidhi.value))} {lang === 'ta' ? 'நாட்கள்' : 'days'})</p>
      <Cite rows={vidhi} lang={lang} csv="trial_duration" />

      <h3 class="sub-h">{t('home.justice_ftsc_title')}</h3>
      <p>{t('home.justice_ftsc_lead', { year: fYear, registered: fmtInt(ftsc(fYear, 'registered').value), disposed: fmtInt(ftsc(fYear, 'disposed').value), pending: fmtInt(ftsc(fYear, 'pending_end_year').value) })}</p>
      {ftscYears.map((y) => (
        <div class="ftsc-year">
          <p class="yr num">{y}</p>
          <BarList
            ariaLabel={`${y}`}
            max={Math.max(...where({ dataset: 'ftsc_flow', geo: 'IN' }).map((r) => r.value))}
            bars={[
              { label: t('home.justice_ftsc_registered'), value: ftsc(y, 'registered').value, valueLabel: fmtInt(ftsc(y, 'registered').value), color: 'var(--c-known)' },
              { label: t('home.justice_ftsc_disposed'), value: ftsc(y, 'disposed').value, valueLabel: fmtInt(ftsc(y, 'disposed').value), color: 'var(--c-unknown)' },
              { label: t('home.justice_ftsc_pending'), value: ftsc(y, 'pending_end_year').value, valueLabel: fmtInt(ftsc(y, 'pending_end_year').value), color: 'var(--c-family)', emphasis: true },
            ]}
          />
        </div>
      ))}
      <DataTable lang={lang} caption="Fast-track special courts" head={[t('common.year'), t('home.justice_ftsc_registered'), t('home.justice_ftsc_disposed'), t('home.justice_ftsc_pending')]} numeric={[1, 2, 3]}
        rows={ftscYears.map((y) => [String(y), fmtInt(ftsc(y, 'registered').value), fmtInt(ftsc(y, 'disposed').value), fmtInt(ftsc(y, 'pending_end_year').value)])} />
      <p class="small muted">{t('home.justice_ftsc_note', { courts: fmtInt(ftscCourts.value), pocso: fmtInt(ftscPocso.value), date: fmtDate(ftscCourts.as_of_date, lang) })}</p>
      <Cite rows={[...where({ dataset: 'ftsc_flow', geo: 'IN' }), ftscCourts]} lang={lang} csv="ftsc_flow" />

      {courtYear === undefined
        ? <p class="pending small">{t('home.justice_funnel_pending', { year: sYear })}</p>
        : <><h3 class="sub-h">{lang === 'ta' ? 'காவல் நிலையத்திலிருந்து தீர்ப்பு வரை' : 'From police station to verdict'}</h3><JusticeFunnel lang={lang} year={courtYear} /></>}
      <ActionCard lang={lang} text={t('home.justice_action')} />
    </div>
  </section>

  <!-- 6 · What you can do -->
  <section class="section" id="act" aria-labelledby="act-h">
    <div class="wrap">
      <p class="kicker">{t('home.act_kicker')}</p>
      <h2 id="act-h">{t('home.act_title')}</h2>
      {!PREVENTION_CONTENT_REVIEWED && <p><span class="draft">{t('common.draft')}</span></p>}
      <p class="lead">{t('home.act_lead')}</p>
      <ol class="actions">
        {ACTIONS.map((i) => (
          <li>
            <h3>{t(`home.act_${i}_t`)}</h3>
            <p>{t(`home.act_${i}_b`)}</p>
          </li>
        ))}
      </ol>

      <h2 class="help-h" id="help">{t('home.help_title')}</h2>
      <p>{t('home.help_lead')}</p>
      <Helplines lang={lang} />

      <div class="card explore">
        <h2>{t('home.explore_title')}</h2>
        <p>{t('home.explore_lead')}</p>
        <p class="links">
          <a class="btn primary" href={`/${lang}/explore/india/`}>{t('nav.india')} →</a>
          <a class="btn" href={`/${lang}/explore/tamil-nadu/`}>{t('nav.tn')} →</a>
          <a class="btn" href={`/${lang}/data/`}>{t('nav.data')}</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hook { padding: 3rem 0 2.5rem; }
  .hook h1 { max-width: 20ch; }
  :global(:lang(ta)) .hook h1 { max-width: none; }
  .waffle { margin: 1.5rem 0 0.5rem; }
  .waffle svg { display: block; width: 160px; height: 160px; }
  .tn { margin-top: 1.5rem; }
  .explainer { margin-top: 1.5rem; }
  .explainer h3 { font-size: 1rem; }
  .sub-h { margin-top: 2.25rem; }
  .ftsc-year { margin-top: 1rem; }
  .yr { font-weight: 700; margin: 0 0 -0.5rem; }
  .actions { padding-left: 1.4rem; margin: 1.5rem 0; }
  .actions li { margin-bottom: 1.1rem; padding-left: 0.3rem; }
  .actions li::marker { font-weight: 700; color: var(--accent); }
  .actions h3 { font-size: 1.05rem; margin-bottom: 0.25rem; }
  .actions p { margin: 0; color: var(--ink-2); }
  .help-h { margin-top: 2.5rem; }
  .explore { margin-top: 2.5rem; }
  .explore .links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; }
</style>

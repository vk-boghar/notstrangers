---
import Base from '../../layouts/Base.astro';
import Helplines from '../../components/Helplines.astro';
import { LANGS, type Lang } from '../../config/site';
import { useT } from '../../i18n';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const { t } = useT(lang);
---
<Base lang={lang} title={t('pages.help_title')}>
  <div class="wrap page">
    <h1>{t('pages.help_title')}</h1>
    <p class="lead">{t('pages.help_lead')}</p>
    <Helplines lang={lang} />
    <section class="card disclose">
      <h2>{t('pages.help_disclose_title')}</h2>
      <p><strong>{t('home.act_5_t')}</strong></p>
      <p>{t('home.act_5_b')}</p>
      <p><a href={`/${lang}/guide/#tells`}>{t("nav.guide")} →</a></p>
    </section>
  </div>
</Base>
<style> .disclose { margin-top: 2rem; } .disclose h2 { font-size: 1.2rem; }</style>

# Cloudflare Pages / Netlify headers. Everything is served from this origin except the cookie-free
# Cloudflare Web Analytics beacon and our own module counter.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://notstrangers-metrics.vaikunthln.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()
  X-Frame-Options: DENY

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/share/*
  Cache-Control: public, max-age=86400

/data/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
